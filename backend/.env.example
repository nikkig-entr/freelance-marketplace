# Backend Environment Variables
# Copy to .env for local development

# ============================================
# APP SETTINGS
# ============================================
APP_NAME=Freelance Marketplace
DEBUG=true
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/freelance
DATABASE_URL_TEST=sqlite+aiosqlite:///./test.db

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY (JWT)
# ============================================
SECRET_KEY=change-me-in-production-min-32-chars-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ============================================
# OAUTH PROVIDERS
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Telegram Bot (for login)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@freelance.local
EMAIL_FROM_NAME=Freelance Marketplace

# ============================================
# MEILISEARCH
# ============================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ============================================
# MINIO (S3-compatible storage)
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=freelance
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000/freelance

# ============================================
# STRIPE BILLING
# ============================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly
STRIPE_SUCCESS_URL=http://localhost:5173/settings/billing?success=true
STRIPE_CANCEL_URL=http://localhost:5173/pricing?canceled=true

# ============================================
# AI (OpenAI / Anthropic)
# ============================================
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AI_MODEL=gpt-4o-mini

# ============================================
# TELEGRAM NOTIFICATIONS (Admin alerts)
# ============================================
TELEGRAM_NOTIFY_BOT_TOKEN=your-notify-bot-token
TELEGRAM_NOTIFY_CHAT_ID=your-chat-id

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# PLAN LIMITS (configured in config.py)
# ============================================
# STARTER: 2 bids/week, 1 active project, 5% commission, no AI
# PRO: unlimited bids/projects, 3% commission, AI matching + wizard
# AGENCY: unlimited, 2% commission, AI, team seats (5)